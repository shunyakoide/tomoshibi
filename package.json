{
  "name": "lamp-kit-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser generator for the 3D-printable forming mold used to build AKARI-style washi paper lanterns.",
  "license": "MIT",
  "author": "Shunya Koide",
  "keywords": [
    "3d-printing",
    "stl",
    "lantern",
    "akari",
    "washi",
    "chochin",
    "three-js",
    "generative",
    "papercraft"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shunyakoide/lamp-kit-generator"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check:manifold": "node scripts/manifold.mjs",
    "check:hash": "node scripts/hash.mjs",
    "check:persist": "node scripts/persist.test.mjs",
    "check:paper": "node scripts/paper.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  }
}
