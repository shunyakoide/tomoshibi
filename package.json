{
  "name": "lamp-kit-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser generator for the 3D-printable forming mold used to build washi paper lanterns (paper lamps).",
  "license": "MIT",
  "author": "Shunya Koide",
  "keywords": [
    "3d-printing",
    "stl",
    "lantern",
    "paper-lamp",
    "washi",
    "chochin",
    "three-js",
    "generative",
    "papercraft"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shunyakoide/lamp-kit-generator"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check:manifold": "node scripts/manifold.mjs",
    "check:hash": "node scripts/hash.mjs",
    "check:persist": "node scripts/persist.test.mjs",
    "check:paper": "node scripts/paper.test.mjs",
    "check:i18n": "node scripts/i18n.test.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^8.2.1"
  }
}
